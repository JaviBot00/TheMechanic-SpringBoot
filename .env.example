# =============================================================================
# .env.example - Plantilla de variables de entorno
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este fichero: cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. NUNCA subas .env al repositorio (está en .gitignore)
#
# En producción estas variables se definen en docker-compose.yml o en
# el sistema de secretos del servidor (Vault, AWS Secrets Manager, etc.)
# =============================================================================

# ---------------------------------------------------------------------------
# PERFIL DE SPRING
# Valores posibles: dev, prod
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# BASE DE DATOS (solo necesario en perfil prod)
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/workshopdb
SPRING_DATASOURCE_USERNAME=workshop_user
SPRING_DATASOURCE_PASSWORD=changeme_in_production

# ---------------------------------------------------------------------------
# SEGURIDAD JWT
# La clave secreta debe tener al menos 32 caracteres (256 bits para HS256).
# Generar una clave segura: openssl rand -base64 64
# ---------------------------------------------------------------------------
SECURITY_JWT_SECRET_KEY=replace-this-with-a-secure-random-key-min-32-chars
SECURITY_JWT_ACCESS_TOKEN_EXPIRATION=3600000
SECURITY_JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ---------------------------------------------------------------------------
# SERVIDOR (opcional, por defecto 8080)
# ---------------------------------------------------------------------------
SERVER_PORT=8080
