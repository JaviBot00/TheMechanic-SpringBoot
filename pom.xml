<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         PARENT: Spring Boot BOM (Bill of Materials)
         Gestiona automáticamente las versiones compatibles de todas
         las dependencias de Spring. No necesitamos especificar
         versiones individualmente para la mayoría de dependencias.
         ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <!-- ============================================================
         COORDENADAS DEL PROYECTO
         groupId:    dominio inverso de la organización
         artifactId: nombre del artefacto generado (el .jar)
         version:    versión actual del proyecto
         ============================================================ -->
    <groupId>com.hotguy.workshopmanagement</groupId>
    <artifactId>workshop-management-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Workshop Management API</name>
    <description>
        API REST para la gestión integral de un taller mecánico.
        Incluye gestión de clientes, mecánicos, vehículos y tareas de taller,
        con autenticación JWT y control de acceso por roles.
    </description>

    <!-- ============================================================
         PROPIEDADES GLOBALES DEL PROYECTO
         Centralizamos aquí todas las versiones de dependencias que
         no gestiona el BOM de Spring Boot automáticamente.
         ============================================================ -->
    <properties>
        <!-- Versión de Java. Spring Boot 4 requiere Java 21 como mínimo. -->
        <java.version>21</java.version>

        <!-- Encoding estándar para evitar problemas con caracteres especiales -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versiones de dependencias no gestionadas por el BOM de Spring -->
        <jjwt.version>0.13.0</jjwt.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>3.0.3</springdoc.version>
    </properties>

    <!-- ============================================================
         DEPENDENCIAS
         Agrupadas por responsabilidad para facilitar la lectura.
         ============================================================ -->
    <dependencies>

        <!-- ── NÚCLEO DE SPRING BOOT ─────────────────────────────── -->

        <!--
            spring-boot-starter-web
            Incluye: Spring MVC, Tomcat embebido, Jackson (JSON).
            Es el punto de entrada para construir APIs REST.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-validation
            Incluye: Hibernate Validator, Bean Validation (Jakarta).
            Permite anotar DTOs con @NotNull, @Email, @Size, etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            spring-boot-starter-actuator
            Expone endpoints de monitorización: /actuator/health,
            /actuator/info, /actuator/metrics, etc.
            Esencial para entornos de producción.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── PERSISTENCIA ──────────────────────────────────────── -->

        <!--
            spring-boot-starter-data-jpa
            Incluye: Spring Data JPA, Hibernate 7, gestión de
            transacciones. Nos permite definir repositorios con
            interfaces sin implementar SQL manualmente.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            spring-boot-starter-flyway
            En Spring Boot 4, el starter es obligatorio para que
            Flyway se auto-configure. Ya no basta con flyway-core.
            Ejecuta automáticamente los scripts SQL al arrancar.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!--
            flyway-database-postgresql
            Driver específico de Flyway para PostgreSQL (prod).
            Separado del core desde Flyway 10+.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            postgresql
            Driver JDBC oficial de PostgreSQL. Solo necesario en
            tiempo de ejecución, no en compilación.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            h2
            Base de datos embebida en memoria para el perfil dev.
            Solo cargada en tiempo de ejecución; no entra en el
            artefacto de producción.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── SEGURIDAD ─────────────────────────────────────────── -->

        <!--
            spring-boot-starter-security
            Incluye: Spring Security 7. Activa automáticamente la
            protección de todos los endpoints al añadirse al classpath.
            La configuración se realiza en SecurityConfig.java.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            jjwt-api
            API pública de la librería JJWT para crear y validar
            JSON Web Tokens. Solo la API va en compile scope.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <!--
            jjwt-impl
            Implementación interna de JJWT. Debe declararse en
            runtime para evitar dependencias directas a internals.
            JJWT garantiza compatibilidad solo a través de su API.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            jjwt-jackson
            Integración de JJWT con Jackson para serializar/deserializar
            el payload del token en JSON. Runtime porque JJWT lo
            detecta automáticamente en el classpath.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ── MAPEO DE OBJETOS ──────────────────────────────────── -->

        <!--
            mapstruct
            Genera código de conversión entre entidades JPA y DTOs
            en tiempo de compilación. Más eficiente que frameworks
            de reflection como ModelMapper.
        -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ── REDUCCIÓN DE BOILERPLATE ─────────────────────────── -->

        <!--
            lombok
            Genera getters, setters, constructores, builders, etc.
            mediante anotaciones en tiempo de compilación.
            El BOM de Spring Boot gestiona su versión.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── DOCUMENTACIÓN API ─────────────────────────────────── -->

        <!--
            springdoc-openapi-starter-webmvc-ui
            Genera automáticamente la especificación OpenAPI 3.1
            y expone Swagger UI en /swagger-ui.html.
            Compatible con Spring Boot 4 y Spring Security.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ── TESTING ───────────────────────────────────────────── -->

        <!--
            spring-boot-starter-test
            Incluye: JUnit 5 (Jupiter), Mockito, AssertJ, MockMvc.
            El scope test asegura que no entra en el artefacto final.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            spring-security-test
            Utilidades para testear endpoints protegidos por Spring
            Security: @WithMockUser, SecurityMockMvcRequestPostProcessors, etc.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ============================================================
         BUILD Y PLUGINS
         ============================================================ -->
    <build>
        <plugins>

            <!--
                spring-boot-maven-plugin
                Empaqueta la aplicación como un "fat JAR" ejecutable
                que incluye todas las dependencias y el servidor Tomcat.
                También excluye Lombok del artefacto final (no necesario
                en runtime, solo en compilación).
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                maven-compiler-plugin
                Configura el compilador Java con soporte para múltiples
                procesadores de anotaciones. El orden importa:
                1. Lombok primero (genera getters/setters)
                2. MapStruct segundo (usa los métodos generados por Lombok)
                Si el orden se invierte, MapStruct no encontrará los
                accessors de Lombok y fallará la compilación.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <!-- Lombok SIEMPRE antes que MapStruct -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!--
                            Indica a MapStruct que use Spring para inyectar
                            los mappers como beans (@Autowired / @Component)
                        -->
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!--
                jacoco-maven-plugin
                Genera reportes de cobertura de tests.
                - prepare-agent: instrumenta el bytecode para medir cobertura
                - report: genera el reporte HTML en target/site/jacoco/
                Ejecutar con: mvn verify
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
